{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_BACKEND_PRIMARY": "https://billing.jagalikoota.com/api/v1/hotel",
    "VITE_BACKEND_SECONDARY": "https://hotelviratbackend.onrender.com/api/v1/hotel"
  }
}